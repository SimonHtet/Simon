datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      String   @default("front_desk")
  hotelId   String   @default("HOTEL-001")
  createdAt DateTime @default(now())
}

model Hotel {
  id        String   @id
  name      String
  location  String
  createdAt DateTime @default(now())
}

model Room {
  id           String        @id
  floor        Int
  type         String
  status       String        @default("available")
  resId        String?
  hotelId      String        @default("HOTEL-001")
  updatedAt    DateTime      @updatedAt
  reservations Reservation[]
}

model Guest {
  id              String        @id @default(cuid())
  name            String
  firstName       String?
  lastName        String?
  preferredName   String?
  birthday        String?
  nationality     String?
  email           String?
  phone           String?
  passportNumber  String?
  passportExpiry  String?
  language        String?
  memberNumber    String?
  vipStatus       String?
  company         String?
  city            String?
  country         String?
  hotelId         String        @default("HOTEL-001")
  preferenceNotes String?
  specialRequests String?
  smokingPref     String?
  bedPref         String?
  pillowPref      String?
  floorPref       String?
  viewPref        String?
  temperaturePref String?
  allergiesPref   String?
  createdAt       DateTime      @default(now())
  reservations    Reservation[]
}

model ChargeCode {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  category    String
  description String
  price       Float
  active      Boolean  @default(true)
  hotelId     String   @default("HOTEL-001")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Company {
  id             String        @id @default(cuid())
  hotelId        String        @default("HOTEL-001")
  name           String
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  address        String?
  taxId          String?
  notes          String?
  type           String        @default("COMPANY")
  contractRates  Json          @default("{}")
  blackoutStart  String?
  blackoutEnd    String?
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  reservations   Reservation[]
}

model Reservation {
  id                 String    @id @default(cuid())
  reservationNumber  String    @unique
  hotelId            String    @default("HOTEL-001")
  guestId            String
  guest              Guest     @relation(fields: [guestId], references: [id])
  guestName          String
  nationality        String?
  roomId             String
  room               Room      @relation(fields: [roomId], references: [id])
  roomTypeId         String
  status             String    @default("confirmed")
  checkIn            String
  checkOut           String
  rate               Float
  totalNights        Int
  totalAmount        Float
  adults             Int       @default(1)
  children           Int       @default(0)
  source             String?
  bookingReference   String?
  vipStatus          String?
  passportNumber     String?
  companyId          String?
  company            Company?  @relation(fields: [companyId], references: [id])
  specials           String?
  eta                String?
  flightNumber       String?
  visaDetails        String?
  turndown           Boolean   @default(false)
  dnm                Boolean   @default(false)
  actualCheckIn      DateTime?
  actualCheckOut     DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  moveReason         String?
  isMaster           Boolean   @default(false)
  masterResId        String?
  masterReservation  Reservation?  @relation("MasterLinked", fields: [masterResId], references: [id])
  linkedReservations Reservation[] @relation("MasterLinked")
  preferredName      String?
  birthday           String?
  passportExpiry     String?
  language           String?
  memberNumber       String?
  city               String?
  country            String?
  createdBy          String?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  charges            Charge[]
  traces             Trace[]
  packages           Package[]
  preferences        Preferences?
}

model Charge {
  id            Int         @id @default(autoincrement())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  item          String
  amount        Float
  date          String
  category      String?
  createdAt     DateTime    @default(now())
}

model Trace {
  id            Int         @id @default(autoincrement())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  text          String
  date          String
  status        String      @default("pending")
  department    String      @default("FRONT OFFICE")
  createdAt     DateTime    @default(now())
}

model Package {
  id            Int         @id @default(autoincrement())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  pkgId         String
  active        Boolean     @default(false)
  licensePlate  String?
  carModel      String?
}

model Preferences {
  id            Int         @id @default(autoincrement())
  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  smoking       String?
  bed           String?
  pillow        String?
  floor         String?
  view          String?
  temperature   String?
  allergies     String?
  amenities     String?
  notes         String?
  updatedAt     DateTime    @updatedAt
}
