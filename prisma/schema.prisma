datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      String   @default("front_desk")
  hotelId   String   @default("HOTEL-001")
  createdAt DateTime @default(now())

  @@index([hotelId])
}

model Hotel {
  id        String   @id
  name      String
  location  String
  createdAt DateTime @default(now())
}

model Room {
  id           String        @id
  floor        Int
  type         String
  status       String        @default("available")
  resId        String?
  hotelId      String        @default("HOTEL-001")
  updatedAt    DateTime      @updatedAt
  reservations Reservation[]

  @@index([hotelId])
  @@index([hotelId, status])
}

model Guest {
  id              String        @id @default(cuid())
  name            String
  firstName       String?
  lastName        String?
  preferredName   String?
  birthday        String?
  nationality     String?
  email           String?
  phone           String?
  passportNumber  String?
  passportExpiry  String?
  language        String?
  memberNumber    String?
  vipStatus       String?
  company         String?
  city            String?
  country         String?
  hotelId         String        @default("HOTEL-001")
  preferenceNotes String?
  specialRequests String?
  smokingPref     String?
  bedPref         String?
  pillowPref      String?
  floorPref       String?
  viewPref        String?
  temperaturePref String?
  allergiesPref   String?
  createdAt       DateTime      @default(now())
  reservations    Reservation[]

  @@index([hotelId])
  @@index([hotelId, name])
  @@index([hotelId, passportNumber])
  @@index([hotelId, email])
  @@index([hotelId, phone])
}

model ChargeCode {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  category    String
  description String
  price       Float
  active      Boolean  @default(true)
  hotelId     String   @default("HOTEL-001")
  parentCode  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([hotelId])
  @@index([hotelId, active])
}

model Company {
  id                 String              @id @default(cuid())
  hotelId            String              @default("HOTEL-001")
  name               String
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  address            String?
  taxId              String?
  notes              String?
  type               String              @default("COMPANY")
  contractRates      Json                @default("{}")
  blackoutStart      String?
  blackoutEnd        String?
  active             Boolean             @default(true)
  creditLimit        Float               @default(0)
  creditUsed         Float               @default(0)
  creditResetDay     Int                 @default(1)
  lastCreditReset    String?
  bankName           String?
  bankAccountName    String?
  bankAccountNumber  String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  reservations       Reservation[]
  creditTransactions CreditTransaction[]

  @@index([hotelId])
  @@index([hotelId, type])
  @@index([hotelId, active])
}

model Reservation {
  id                 String        @id @default(cuid())
  reservationNumber  String        @unique
  hotelId            String        @default("HOTEL-001")
  guestId            String
  guest              Guest         @relation(fields: [guestId], references: [id])
  guestName          String
  nationality        String?
  roomId             String
  room               Room          @relation(fields: [roomId], references: [id])
  roomTypeId         String
  status             String        @default("confirmed")
  checkIn            String
  checkOut           String
  rate               Float
  totalNights        Int
  totalAmount        Float
  adults             Int           @default(1)
  children           Int           @default(0)
  source             String?
  bookingReference   String?
  vipStatus          String?
  passportNumber     String?
  companyId          String?
  company            Company?      @relation(fields: [companyId], references: [id])
  specials           String?
  eta                String?
  flightNumber       String?
  visaDetails        String?
  turndown           Boolean       @default(false)
  dnm                Boolean       @default(false)
  actualCheckIn      DateTime?
  actualCheckOut     DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  moveReason         String?
  isMaster           Boolean       @default(false)
  masterResId        String?
  masterReservation  Reservation?  @relation("MasterLinked", fields: [masterResId], references: [id])
  linkedReservations Reservation[] @relation("MasterLinked")
  preferredName      String?
  birthday           String?
  passportExpiry     String?
  language           String?
  memberNumber       String?
  city               String?
  country            String?
  createdBy          String?
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  charges            Charge[]
  traces             Trace[]
  packages           Package[]
  preferences        Preferences?
  folios             Folio[]

  @@index([hotelId])
  @@index([hotelId, status])
  @@index([hotelId, checkIn])
  @@index([hotelId, checkOut])
  @@index([hotelId, status, checkIn])
  @@index([hotelId, status, checkOut])
  @@index([roomId])
  @@index([guestId])
  @@index([companyId])
  @@index([masterResId])
}

model Charge {
  id            Int          @id @default(autoincrement())
  reservationId String
  reservation   Reservation  @relation(fields: [reservationId], references: [id])
  item          String
  amount        Float
  date          String
  category      String?
  createdAt     DateTime     @default(now())
  folioCharge   FolioCharge?

  @@index([reservationId])
  @@index([date])
}

model Folio {
  id            Int           @id @default(autoincrement())
  reservationId String
  reservation   Reservation   @relation(fields: [reservationId], references: [id])
  name          String
  paymentMethod String?
  status        String        @default("open")
  settledAt     DateTime?
  createdAt     DateTime      @default(now())
  charges       FolioCharge[]

  @@index([reservationId])
}

model FolioCharge {
  id       Int    @id @default(autoincrement())
  folioId  Int
  folio    Folio  @relation(fields: [folioId], references: [id])
  chargeId Int    @unique
  charge   Charge @relation(fields: [chargeId], references: [id])

  @@index([folioId])
}

model Trace {
  id            Int         @id @default(autoincrement())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  text          String
  date          String
  status        String      @default("pending")
  department    String      @default("FRONT OFFICE")
  createdAt     DateTime    @default(now())

  @@index([reservationId])
  @@index([status])
  @@index([reservationId, status])
}

model Package {
  id            Int         @id @default(autoincrement())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  pkgId         String
  active        Boolean     @default(false)
  licensePlate  String?
  carModel      String?

  @@index([reservationId])
}

model CreditTransaction {
  id            Int       @id @default(autoincrement())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  hotelId       String    @default("HOTEL-001")
  reservationId String?
  folioId       Int?
  amount        Float
  description   String
  status        String    @default("unpaid")
  paidAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([companyId])
  @@index([hotelId])
  @@index([reservationId])
  @@index([companyId, status])
}

model NightAudit {
  id            Int      @id @default(autoincrement())
  hotelId       String
  businessDate  String
  chargesPosted Int
  totalAmount   Float
  runBy         String
  createdAt     DateTime @default(now())

  @@unique([hotelId, businessDate])
}

model Preferences {
  id            Int         @id @default(autoincrement())
  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  smoking       String?
  bed           String?
  pillow        String?
  floor         String?
  view          String?
  temperature   String?
  allergies     String?
  amenities     String?
  notes         String?
  updatedAt     DateTime    @updatedAt
}
